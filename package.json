{
  "name": "dsh-den",
  "version": "0.1.0",
  "description": "A 7x24 resident personal assistant for DeepSeek Harness: human-bound standing autonomy, self-wake across restarts, expiry-aware notices that stay silent unless they matter, and an outbound approval gate the assistant cannot talk its way past.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    "test",
    "tools"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:bundle": "node tools/check-client-bundle.mjs",
    "check:ui": "node tools/check-client-interaction.mjs",
    "check:acceptance": "node tools/check-acceptance.mjs",
    "check:deployment": "node tools/check-deployment.mjs",
    "verify:live": "node tools/verify-after-restart.mjs",
    "check:tools": "node tools/check-tools-live.mjs",
    "diagnose:status": "node tools/diagnose-status-output.mjs",
    "check:package": "node tools/check-package-contents.mjs",
    "check:install": "node tools/check-install.mjs",
    "verify": "npm test && npm run check:bundle && npm run check:ui && npm run check:acceptance && npm run check:package && npm run check:install"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "resident",
    "assistant",
    "autonomy",
    "proactive"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-den.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-den#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-den/issues"
  },
  "license": "MIT"
}
